<!DOCTYPE html>
<html lang="en">
<head>
    <style>
    table, th, td {
        border: 2px solid black;
        border-collapse: collapse;
    }
    th, td {
        padding-left: 10px;
        padding-right: 10px;
    }
    .exception-title {
        color: red;
    }
    .exception-message {
        font-style: italic;
    }
    .success-message {
        color: #76B900;
    }
    p, pre {
        margin-top: 2px;
    }
    a {
        text-decoration: none;
    }
    .legend-title {
        margin-top: 10px;
        margin-bottom: 10px;
    }
    </style>
</head>
<body>
    {% if exception %}
    <h3 class="exception-title">Cherry pick exception occurred</h3>
    <p>The exception message:</p>
    <pre class="exception-message">{{ exception }}</pre>
    {% else %}
    {% if commits | length > 0 %}
    <h3>Cherry pick commit from community report</h3>
    <table>
        <thead>
            <tr>
                <th>No.</th>
                <th>Subject</th>
                <th>Short Hash</th>
                <th>Community committer date</th>
            </tr>
        </thead>
        <tbody>
            {% for commit in commits %}
            <tr {% if commit.cherry_pick_status.value | int == 3 %}
                style="background-color: #db756e;" {# CONFLICT #}
                {% elif  commit.cherry_pick_status.value | int == 1 %}
                style="background-color: #76B900;" {# SUCCESS #}
                {% elif  commit.cherry_pick_status.value | int == 2 %}
                style="background-color: #daf1ff;" {# ALREADY INCLUDED #}
                {% elif  commit.cherry_pick_status.value | int == 4 %}
                style="background-color: #FFFFFF;" {# EMPTY COMMIT #}
                {% endif %}>
                <td>{{ loop.index }}</td>
                <td>
                    {{ commit.subject | link_pr_in_subject }}
                </td>
                <td>{{ commit.hash[:8] }}</td>
                <td>{{ commit.ct | format_ts }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    {% else %}
    <p>No commit to cherry pick. You're up to date! 🎉</p>
    {% endif %}     {# end of if commits | length > 0 #}
    {# Show legend of colors #}
    {% set color_and_status = {"#db756e": "Conflict", "#76B900": "Success",
                            "#daf1ff": "Included", "#FFFFFF": "Empty"} %}
    <h4 class="legend-title">Legend</h4>
    <table style="border: none; margin-bottom: 10px;">
        <tr>
            {% for color, status in color_and_status.items() %}
                <td style="border: 2px solid black; background-color: {{ color }}; 
                           width: 120px; height: 22px; text-align: center; 
                           font-size: 12px; padding: 0;">
                    {{ status }}
                </td>
            {% endfor %}
        </tr>
    </table>
    {% if cr_on_top %}
    <p>The top CR link: {{ cr_on_top }}</p>
    {% endif %}
    {% if total_commits > 0 %}
        <p>Total number of commits to cherry pick: {{ total_commits }}</p>
        {% if not has_conflict and total_commits == commits | length %}
        <p class="success-message">All the {{total_commits}} commit(s) have been cherry picked successfully! 🎉</p>
        {% endif %}
    {% endif %}
    {% endif %}{# end of if exception condition #}
    {% if build_url %}
    <p>The build URL: <a href="{{ build_url }}">{{ build_url }}</a></p>
    {% endif %}
    {% if triggered_by %}
    <p>Cherry pick triggered by: {{ triggered_by }}</p>
    {% endif %}
</body>
</html>
