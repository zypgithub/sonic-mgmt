<?xml version='1.0' encoding='UTF-8'?>
<DBDEF>
	<global>
		<default_params_type> extended_setup_step_params </default_params_type>
		<DB>
            <info> Smartswitch Tests </info>
            <owner> SONiC </owner>
            <group> SONiC </group>

            <!-- OPTIONAL TAGS -->
            <tags> SMARTSWITCH </tags>

            <ignore>
                <condition>
                    <key> dut_hwsku </key>
                    <op> not in </op>
                    <value> [Mellanox-SN4280-O28] </value>
                </condition>
            </ignore>

            <!-- pre db commands - executed once before DB run -->
            <pre>
            </pre>

            <!-- post db commands - executed once after DB run -->
            <post>
            </post>
        </DB>
		<Test>
			<post> </post>
		</Test>
		<Case>
            <pre>
			</pre>
			<post>
			</post>
		</Case>
	</global>
	<test>
		<cases> sonic-mgmt/sonic-tool/mars/cases/canonical/thermal_control.cases </cases>
	</test>
</DBDEF>
