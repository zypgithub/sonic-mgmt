<?xml version="1.0" encoding="UTF-8"?>
<DBDEF>
    <global>
        <!-- parameters passed to setup steps commands-->
        <default_params_type> basic_setup_step_params </default_params_type>
        <DB>
            <info> ACL </info>
            <owner> SONiC </owner>
            <group> SONiC </group>

            <!-- OPTIONAL TAGS -->
            <tags> Upgrade, MAC move, pfc-wd </tags>

            <!-- pre db commands - executed once before DB run -->
            <pre>
            </pre>
            <ignore>
                <condition>
                    <key> topology </key>
                    <op> not in </op>
                    <value> ["t0", "t0-56", "t0-64", "t0-120", "t0-56-o8v48"] </value>
                </condition>
                <condition>
                    <key> target_version_specified:(no) </key>
                    <op> == </op>
                    <value> no </value>
                </condition>
                <!-- weekend case -->
                <condition>
                    <key> skip_weekend_cases </key>
                    <op> == </op>
                    <value> yes </value>
                </condition>
                <!-- Case only for main hwsku, skip this case if it is non-main hwsku -->
                <condition>
                    <key> skip_main_hwsku_only_cases </key>
                    <op> == </op>
                    <value> yes </value>
                </condition>
            </ignore>
            <post></post>
        </DB>
        <Test>
            <!--Must reset any dynamic ignore tags created by other tests-->
            <pre>
                <type> reg_exec_func </type>
                <name> reset dynamic ignore tags </name>
                <mars_cmd_func> reset_dynamic_tags </mars_cmd_func>
                <tout> 60 </tout>
                <params>
                    <tags_type> ignore_tags </tags_type>
                </params>
            </pre>
            <post>
            </post>
        </Test>
        <Case>
            <on_not_success>
                <name> Generate sysdump on not success </name>
                <type> setup_mode </type>
                <cmd>
                    <type> reg_exec_cmd </type>
                    <players_selection>
                        <ep_targets> SONIC_MGMT </ep_targets>
                    </players_selection>
                    <name> run_on_stm </name>
                    <tout> 900 </tout>
                    <params>
                        <exec> PYTHONPATH=/devts/ /ngts_venv/bin/pytest /root/mars/workspace/sonic-mgmt/ngts/scripts/store_techsupport_on_not_success.py  --sonic-topo=[[conf:extra_info.topology]]  --setup_name=[[conf:extra_info.setup_name]] --tech_support_duration=7200  --session_id=[[run_time:session_id]]  --rootdir=/root/mars/workspace/sonic-mgmt/ngts -c /root/mars/workspace/sonic-mgmt/ngts/pytest.ini     --log-level=INFO --clean-alluredir --alluredir=/tmp/allure-results</exec>
                    </params>
                </cmd>
            </on_not_success>
            <!-- OPTIONAL TAGS -->
            <!--<tags> TAG NAME </tags>-->
            <pre></pre>
            <ignore></ignore>
            <post></post>
        </Case>

    </global>

    <test>
        <cases> sonic-mgmt/sonic-tool/mars/cases/community/upgrade_related.cases </cases>
    </test>

</DBDEF>
