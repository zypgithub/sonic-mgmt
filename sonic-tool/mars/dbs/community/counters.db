<?xml version="1.0" encoding="UTF-8"?>
<DBDEF>
    <global>
        <!-- parameters passed to setup steps commands-->
        <default_params_type> basic_setup_step_params </default_params_type>
        <DB>
            <info> DROP_COUNTER </info>
            <owner> SONiC </owner>
            <group> SONiC </group>

            <!-- OPTIONAL TAGS -->
            <tags> DROP_COUNTER </tags>

            <!-- pre db commands - executed once before DB run -->
            <pre>
            </pre>

            <!-- post db commands - executed once after DB run -->
            <post>
            </post>
        </DB>
        <Test>
            <!--Must reset any dynamic ignore tags created by other tests-->
            <pre>
                <type> reg_exec_func </type>
                <name> reset dynamic ignore tags </name>
                <mars_cmd_func> reset_dynamic_tags </mars_cmd_func>
                <tout> 60 </tout>
                <params>
                    <tags_type> ignore_tags </tags_type>
                </params>
            </pre>
            <post>
            </post>
        </Test>
        <Case>
        </Case>
    </global>

    <test>
        <cases> sonic-mgmt/sonic-tool/mars/cases/community/drop_counters.cases </cases>
        <ignore>
            <!-- Case only for main hwsku, skip this case if it is non-main hwsku -->
            <condition>
                <key> skip_main_hwsku_only_cases </key>
                <op> == </op>
                <value> yes </value>
            </condition>
        </ignore>
    </test>

    <test>
        <cases> sonic-mgmt/sonic-tool/mars/cases/community/portstat.cases </cases>
    </test>

    <test>
        <cases> sonic-mgmt/sonic-tool/mars/cases/community/route_flow_counters.cases </cases>
        <ignore>
            <!-- Case only for main hwsku, skip this case if it is non-main hwsku -->
            <condition>
                <key> skip_main_hwsku_only_cases </key>
                <op> == </op>
                <value> yes </value>
            </condition>
        </ignore>
    </test>

</DBDEF>
