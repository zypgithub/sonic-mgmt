<?xml version="1.0" encoding="UTF-8" ?>
<CASEDEF>
  <global>
    <Test>
      <group> SONiC </group>
      <name> Redmine issues refresh </name>
      <info> Update Redmine issues </info>
      <owner> lchekroun </owner>
    </Test>
    <Case>
      <tags> redmine refresh </tags>
      <wrapper> [[run_time:db_tests_path]]/sonic-mgmt/sonic-tool/mars/scripts/basic_cmd_runner.py </wrapper>
      <tout> 90000 </tout>
      <tags>ALL</tags>
    </Case>
  </global>
  <case>
    <name> Redmine Refresh </name>
    <info> </info>
    <cmd>
      <params>
          <static_args> --test_script /root/mars/workspace/sonic-mgmt/ngts/scripts/redmine_refresh.py </static_args>
      </params>
    </cmd>
  </case>

</CASEDEF>
