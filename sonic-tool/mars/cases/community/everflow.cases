<?xml version="1.0" encoding="UTF-8"?>
<CASEDEF>
    <global>
        <Test>
            <info> Everflow Test </info>
            <name> everflow_testbed </name>
            <owner> </owner>
        </Test>
        <Case>
            <tags> EVERFLOW </tags>
            <wrapper> [[run_time:db_tests_path]]/sonic-mgmt/sonic-tool/mars/scripts/community_mars_pytest_runner.py  </wrapper>
            <tout> 55555 </tout>
        </Case>
    </global>

    <case>
        <ignore>
            <!-- daily case  -->
            <condition>
                <key> skip_weekend_cases </key>
                <op> == </op>
                <value> no </value>
            </condition>
        </ignore>
        <info> Everflow IPv4 Case </info>
        <name> everflow_testbed </name>
        <cmd>
             <params>
                 <static_args> --sonic-mgmt-dir /root/mars/workspace/[[conf:extra_info.sonic_mgmt_repo_name]] --dut-name [[conf:extra_info.dut_name]] --setup-name [[conf:extra_info.setup_name]] --sonic-topo [[conf:extra_info.topology]] --json-root-dir [[conf:extra_info.json_root_dir]] --raw-options "\'--log-cli-level debug --show-capture=no -ra --showlocals --clean-alluredir --alluredir=/tmp/allure-results --timeout 5000 --session-timeout 5000 --allure_server_addr=\"10.215.11.120\"\'" --test-scripts everflow/test_everflow_testbed.py </static_args>
             </params>
        </cmd>
    </case>
    <case>
        <ignore>
            <!-- daily case  -->
            <condition>
                <key> skip_weekend_cases </key>
                <op> == </op>
                <value> no </value>
            </condition>
            <!-- Case only for main hwsku, skip this case if it is non-main hwsku -->
            <condition>
                <key> skip_main_hwsku_only_cases </key>
                <op> == </op>
                <value> yes </value>
            </condition>
        </ignore>
        <info> Everflow IPv4 Case with policer </info>
        <name> Everflow IPv4 Case with policer </name>
        <cmd>
             <params>
                 <static_args> --sonic-mgmt-dir /root/mars/workspace/[[conf:extra_info.sonic_mgmt_repo_name]] --dut-name [[conf:extra_info.dut_name]] --setup-name [[conf:extra_info.setup_name]] --sonic-topo [[conf:extra_info.topology]] --json-root-dir [[conf:extra_info.json_root_dir]] --raw-options "\'--log-cli-level debug --show-capture=no -ra --showlocals --clean-alluredir -k=\"test_everflow_dscp_with_policer\" --alluredir=/tmp/allure-results --timeout 5000 --session-timeout 5000 --allure_server_addr=\"10.215.11.120\"\'" --test-scripts everflow/test_everflow_testbed.py </static_args>
             </params>
        </cmd>
    </case>

    <case>
        <ignore>
            <!-- daily case  -->
            <condition>
                <key> skip_weekend_cases </key>
                <op> == </op>
                <value> no </value>
            </condition>
        </ignore>
        <info> Everflow IPv6 Case </info>
        <name> everflow_ipv6 </name>
        <cmd>
             <params>
                 <static_args> --sonic-mgmt-dir /root/mars/workspace/[[conf:extra_info.sonic_mgmt_repo_name]] --dut-name [[conf:extra_info.dut_name]] --setup-name [[conf:extra_info.setup_name]] --sonic-topo [[conf:extra_info.topology]] --json-root-dir [[conf:extra_info.json_root_dir]] --raw-options "\'--log-cli-level debug --show-capture=no -ra --showlocals --clean-alluredir --alluredir=/tmp/allure-results --timeout 5000 --session-timeout 5000 --allure_server_addr=\"10.215.11.120\"\'" --test-scripts everflow/test_everflow_ipv6.py </static_args>
             </params>
        </cmd>
    </case>

    <case>
        <ignore>
            <!-- daily case  -->
            <condition>
                <key> skip_weekend_cases </key>
                <op> == </op>
                <value> no </value>
            </condition>
            <!-- Case only for main hwsku, skip this case if it is non-main hwsku -->
            <condition>
                <key> skip_main_hwsku_only_cases </key>
                <op> == </op>
                <value> yes </value>
            </condition>
        </ignore>
        <info> Everflow Per Interface Case </info>
        <name> everflow_per_interface </name>
        <cmd>
             <params>
                 <static_args> --sonic-mgmt-dir /root/mars/workspace/[[conf:extra_info.sonic_mgmt_repo_name]] --dut-name [[conf:extra_info.dut_name]] --setup-name [[conf:extra_info.setup_name]] --sonic-topo [[conf:extra_info.topology]] --json-root-dir [[conf:extra_info.json_root_dir]] --raw-options "\'--log-cli-level debug --show-capture=no -ra --showlocals --clean-alluredir --alluredir=/tmp/allure-results --timeout 1200 --session-timeout 1200 --allure_server_addr=\"10.215.11.120\"\'" --test-scripts everflow/test_everflow_per_interface.py::test_everflow_per_interface </static_args>
             </params>
        </cmd>
    </case>
    <case>
        <ignore>
            <!-- daily case  -->
            <condition>
                <key> skip_weekend_cases </key>
                <op> == </op>
                <value> no </value>
            </condition>
            <!-- Case only for main hwsku, skip this case if it is non-main hwsku -->
            <condition>
                <key> skip_main_hwsku_only_cases </key>
                <op> == </op>
                <value> yes </value>
            </condition>
        </ignore>
        <info> Everflow Packet format </info>
        <name> everflow_packet_format </name>
        <cmd>
             <params>
                 <static_args> --sonic-mgmt-dir /root/mars/workspace/[[conf:extra_info.sonic_mgmt_repo_name]] --dut-name [[conf:extra_info.dut_name]] --setup-name [[conf:extra_info.setup_name]] --sonic-topo [[conf:extra_info.topology]] --json-root-dir [[conf:extra_info.json_root_dir]] --raw-options "\'--log-cli-level debug --show-capture=no -ra --showlocals --clean-alluredir --alluredir=/tmp/allure-results --timeout 1200 --session-timeout 1200 --allure_server_addr=\"10.215.11.120\"\'" --test-scripts everflow/test_everflow_per_interface.py::test_everflow_packet_format </static_args>
             </params>
        </cmd>
    </case>
</CASEDEF>
