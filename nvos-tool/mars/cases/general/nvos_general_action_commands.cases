<?xml version="1.0" encoding="UTF-8" ?>
<CASEDEF>
  <global>
    <Test>
      <group> NVOS </group>
      <name> NVOS General action commands cases </name>
      <owner> Shahar Ben Dov </owner>
    </Test>
    <Case>
      <tags> </tags>
      <wrapper> [[run_time:db_tests_path]]/sonic-mgmt/sonic-tool/mars/scripts/canonical_mars_pytest_runner.py </wrapper>
      <tout> 10800 </tout>
      <tags>ALL</tags>
    </Case>
  </global>
  <case>
    <name> Action Fetch Local Files </name>
    <info> </info>
    <tout> 10800 </tout>
    <cmd>
      <params>
          <static_args> --setup_name [[conf:extra_info.setup_name]]
          --test_script /root/mars/workspace/sonic-mgmt/ngts/tests_nvos/general/test_local_file_fetch.py
          --raw_options "\'--rootdir=/root/mars/workspace/sonic-mgmt/ngts -c /root/mars/workspace/sonic-mgmt/ngts/pytest.ini
          --downgrade_version=[[conf:extra_info.downgrade_version]] --base_version=[[conf:extra_info.base_version]]
          --fw_versions_json_file=[[conf:extra_info.fw_versions_json_file]]
          --log-level=INFO --default_pass_env_var=[[conf:extra_info.default_pass_env_var]] 
          --clean-alluredir --alluredir=/tmp/allure-results --showlocals  [[conf:extra_info.additional_options]]  --timeout 900   \'"</static_args>
      </params>
    </cmd>
  </case>
</CASEDEF>
