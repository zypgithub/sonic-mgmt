<?xml version="1.0" encoding="UTF-8" ?>
<CASEDEF>
  <global>
    <Test>
      <group> NVOS </group>
      <name>System Api Compression</name>
      <info></info>
      <owner>Shahar Ben Dov</owner>
    </Test>
    <Case>
      <tags> System Api Compression</tags>
      <wrapper> [[run_time:db_tests_path]]/sonic-mgmt/sonic-tool/mars/scripts/canonical_mars_pytest_runner.py </wrapper>
      <tout> 1800 </tout>
      <tags>ALL</tags>
    </Case>
  </global>

  <case>
    <name> System Api Compression </name>
    <info>Test API compression functionality with gzip encoding on a random API type</info>
    <tout> 900 </tout>
    <cmd>
      <params>
          <static_args> --setup_name [[conf:extra_info.setup_name]] --test_script /root/mars/workspace/sonic-mgmt/ngts/tests_nvos/system/test_system_api_compression.py --raw_options "\' --rootdir=/root/mars/workspace/sonic-mgmt/ngts -c /root/mars/workspace/sonic-mgmt/ngts/pytest.ini --log-level=INFO --default_pass_env_var=[[conf:extra_info.default_pass_env_var]] --clean-alluredir --alluredir=/tmp/allure-results --showlocals  [[conf:extra_info.additional_options]]  --timeout 900 -k test_system_api_compression  \'"</static_args>
      </params>
    </cmd>
  </case>

  <case>
    <name> System Api Compression Bad Flow </name>
    <info>Test API compression behavior in negative scenarios (compression enabled without gzip request and compression disabled with gzip request)</info>
    <tout> 900 </tout>
    <cmd>
      <params>
          <static_args> --setup_name [[conf:extra_info.setup_name]] --test_script /root/mars/workspace/sonic-mgmt/ngts/tests_nvos/system/test_system_api_compression.py --raw_options "\' --rootdir=/root/mars/workspace/sonic-mgmt/ngts -c /root/mars/workspace/sonic-mgmt/ngts/pytest.ini --log-level=INFO --default_pass_env_var=[[conf:extra_info.default_pass_env_var]] --clean-alluredir --alluredir=/tmp/allure-results --showlocals  [[conf:extra_info.additional_options]]  --timeout 900 -k test_system_api_compress_bad_flow  \'"</static_args>
      </params>
    </cmd>
  </case>

</CASEDEF>