<?xml version="1.0" encoding="UTF-8" ?>
<CASEDEF>
  <global>
    <Test>
      <group> NVOS </group>
      <name> System Reset Factory </name>
      <info></info>
      <owner> Yana Port </owner>
    </Test>
    <Case>
      <tags> System Reset Factory </tags>
      <wrapper> [[run_time:db_tests_path]]/sonic-mgmt/sonic-tool/mars/scripts/canonical_mars_pytest_runner.py </wrapper>
      <tout> 10800 </tout>
      <tags>ALL</tags>
    </Case>
  </global>

  <case>
    <name> System Reset Factory </name>
    <info></info>
    <tout> 10800 </tout>
    <cmd>
      <params>
          <static_args> --setup_name [[conf:extra_info.setup_name]] --test_script /root/mars/workspace/sonic-mgmt/ngts/tests_nvos/system/test_system_factory_reset.py --raw_options "\' --rootdir=/root/mars/workspace/sonic-mgmt/ngts -c /root/mars/workspace/sonic-mgmt/ngts/pytest.ini --log-level=INFO --default_pass_env_var=[[conf:extra_info.default_pass_env_var]] --clean-alluredir  --alluredir=/tmp/allure-results --showlocals  [[conf:extra_info.additional_options]]  --timeout 900  --serial_logger=[[conf:extra_info.serial_logger:analyze_and_open_bugs]] \'"</static_args>
      </params>
    </cmd>
  </case>

</CASEDEF>