<?xml version="1.0" encoding="UTF-8" ?>
<CASEDEF>
  <global>
    <Test>
      <group> NVOS </group>
      <name> CPU BMC Debug Config </name>
      <info></info>
      <owner> Sviatoslav Demniak </owner>
    </Test>
    <Case>
      <tags> system dns </tags>
      <wrapper> [[run_time:db_tests_path]]/sonic-mgmt/sonic-tool/mars/scripts/canonical_mars_pytest_runner.py </wrapper>
      <tout> 10800 </tout>
      <tags>ALL</tags>
    </Case>
  </global>

  <case>
    <name> System CPU Debug config </name>
    <info></info>
    <tout> 10800 </tout>
    <cmd>
      <params>
          <static_args> --setup_name [[conf:extra_info.setup_name]] --test_script /root/mars/workspace/sonic-mgmt/ngts/tests_nvos/system/test_system_cpu_bmc_debug_config.py --raw_options "\' --rootdir=/root/mars/workspace/sonic-mgmt/ngts -c /root/mars/workspace/sonic-mgmt/ngts/pytest.ini -k test_system_cpu_debug_config --log-level=INFO --default_pass_env_var=[[conf:extra_info.default_pass_env_var]] --clean-alluredir --alluredir=/tmp/allure-results --showlocals  [[conf:extra_info.additional_options]]  --timeout 900   \'"</static_args>
      </params>
    </cmd>
    <ignore>
      <condition>
        <key>dut_type</key>
        <op> not in </op>
        <value>[juliet, rosalind, rosalind-surrogate, rosalind-chipless, portia]</value>
      </condition>
    </ignore>
  </case>

  <case>
    <name> System BMC Debug config </name>
    <info></info>
    <tout> 10800 </tout>
    <cmd>
      <params>
          <static_args> --setup_name [[conf:extra_info.setup_name]] --test_script /root/mars/workspace/sonic-mgmt/ngts/tests_nvos/system/test_system_cpu_bmc_debug_config.py --raw_options "\' --rootdir=/root/mars/workspace/sonic-mgmt/ngts -c /root/mars/workspace/sonic-mgmt/ngts/pytest.ini -k test_bmc_debug_config --log-level=INFO --default_pass_env_var=[[conf:extra_info.default_pass_env_var]] --clean-alluredir --alluredir=/tmp/allure-results --showlocals  [[conf:extra_info.additional_options]]  --timeout 900   \'"</static_args>
      </params>
    </cmd>
    <ignore>
      <condition>
        <key>dut_type</key>
        <op> not in </op>
        <value>[juliet, rosalind, rosalind-surrogate, rosalind-chipless, portia]</value>
      </condition>
    </ignore>
  </case>

  <case>
    <name> CPU BMC Negative </name>
    <info></info>
    <tout> 10800 </tout>
    <cmd>
      <params>
          <static_args> --setup_name [[conf:extra_info.setup_name]] --test_script /root/mars/workspace/sonic-mgmt/ngts/tests_nvos/system/test_system_cpu_bmc_debug_config.py --raw_options "\' --rootdir=/root/mars/workspace/sonic-mgmt/ngts -c /root/mars/workspace/sonic-mgmt/ngts/pytest.ini -k test_cpu_bmc_debug_config_negative --log-level=INFO --default_pass_env_var=[[conf:extra_info.default_pass_env_var]] --clean-alluredir --alluredir=/tmp/allure-results --showlocals  [[conf:extra_info.additional_options]]  --timeout 900   \'"</static_args>
      </params>
    </cmd>
    <ignore>
      <condition>
        <key>dut_type</key>
        <op> not in </op>
        <value>[juliet, rosalind, rosalind-surrogate, rosalind-chipless, portia]</value>
      </condition>
    </ignore>
  </case>

</CASEDEF>
