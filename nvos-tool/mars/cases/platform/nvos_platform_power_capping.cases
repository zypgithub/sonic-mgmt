<?xml version="1.0" encoding="UTF-8" ?>
<CASEDEF>
  <global>
    <Test>
      <group> NVOS </group>
      <name> Platform Power Capping </name>
      <info> </info>
      <owner> Itay Koren </owner>
    </Test>
    <Case>
      <wrapper> [[run_time:db_tests_path]]/sonic-mgmt/sonic-tool/mars/scripts/canonical_mars_pytest_runner.py </wrapper>
      <tout> 10800 </tout>
      <tags>ALL</tags>
    </Case>
  </global>

 <case>
    <name> Power Capping </name>
    <info> </info>
    <cmd>
      <params>
          <static_args> --setup_name [[conf:extra_info.setup_name]] --test_script /root/mars/workspace/sonic-mgmt/ngts/tests_nvos/platform/test_platform_power_capping.py --raw_options "\'--rootdir=/root/mars/workspace/sonic-mgmt/ngts -c /root/mars/workspace/sonic-mgmt/ngts/pytest.ini --log-level=INFO --default_pass_env_var=[[conf:extra_info.default_pass_env_var]] --clean-alluredir  --alluredir=/tmp/allure-results --showlocals  [[conf:extra_info.additional_options]]  --timeout 900    --store_la_logs --ignore_la_failure\'"</static_args>
      </params>
    </cmd>
    <ignore>
        <condition>
          <key>dut_hwsku</key>
          <op> not in </op>
          <value>[N5500_LD - JulietNonScaleoutSwitchGB300, N5500_LD - JulietNonScaleoutSwitchGB300QS, N6100_LD - Rosalind, N6150_LD - RosalindSurrogate]</value>
        </condition>
    </ignore>
  </case>

</CASEDEF>
