<?xml version="1.0" encoding="UTF-8" ?>
<CASEDEF>
    <global>
        <Test>
            <group> NVOS </group>
            <name> Tray Admin State </name>
            <info>Tests for SDN tray admin state (maintenance-state) functionality</info>
            <owner> Elias Abboud </owner>
        </Test>
        <Case>
            <tags> Tray Admin State </tags>
            <wrapper> [[run_time:db_tests_path]]/sonic-mgmt/sonic-tool/mars/scripts/canonical_mars_pytest_runner.py </wrapper>
            <tout> 3200 </tout>
            <tags>ALL</tags>
        </Case>
    </global>

    <case>
        <name> Tray Admin State </name>
        <info>Tests for SDN tray admin state including show, state changes, port verification, error flows</info>
        <tout> 3200 </tout>
        <cmd>
            <params>
                <static_args> --setup_name [[conf:extra_info.setup_name]] --test_script /root/mars/workspace/sonic-mgmt/ngts/tests_nvos/cluster/tray_admin_state/test_tray_admin_state.py --raw_options "\'--rootdir=/root/mars/workspace/sonic-mgmt/ngts -c /root/mars/workspace/sonic-mgmt/ngts/pytest.ini --log-level=INFO --default_pass_env_var=[[conf:extra_info.default_pass_env_var]] --clean-alluredir --alluredir=/tmp/allure-results --showlocals  [[conf:extra_info.additional_options]]  --timeout 900   \'"</static_args>
            </params>
        </cmd>
    </case>

</CASEDEF>
