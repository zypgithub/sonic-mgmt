<?xml version="1.0" encoding="UTF-8" ?>
<CASEDEF>
    <global>
        <Test>
            <group> NVOS </group>
            <name> NMX C</name>
            <info></info>
            <owner> Itay Koren </owner>
        </Test>
        <Case>
            <tags> NMX C </tags>
            <wrapper> [[run_time:db_tests_path]]/sonic-mgmt/sonic-tool/mars/scripts/canonical_mars_pytest_runner.py </wrapper>
            <tout> 10800 </tout>
            <tags>ALL</tags>
        </Case>
    </global>

    <case>
        <name> simulator cluster partition </name>
        <info></info>
        <tout> 10800 </tout>
        <cmd>
            <params>
                <static_args> --setup_name [[conf:extra_info.setup_name]] --test_script /root/mars/workspace/sonic-mgmt/ngts/tests_nvos/cluster/nmx_simulator_tests/test_simulated_cluster_partition.py --raw_options "\'--rootdir=/root/mars/workspace/sonic-mgmt/ngts -c /root/mars/workspace/sonic-mgmt/ngts/pytest.ini --log-level=INFO --default_pass_env_var=[[conf:extra_info.default_pass_env_var]] --clean-alluredir --alluredir=/tmp/allure-results --showlocals  [[conf:extra_info.additional_options]]  --timeout 900   \'"</static_args>
            </params>
        </cmd>
    </case>


</CASEDEF>

