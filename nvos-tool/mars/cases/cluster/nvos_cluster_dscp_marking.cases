<?xml version="1.0" encoding="UTF-8" ?>
<CASEDEF>
    <global>
        <Test>
            <group> NVOS </group>
            <name> Cluster DSCP Marking </name>
            <info> Testing DSCP marking configuration for cluster control plane </info>
            <owner> Nadav VIlder </owner>
        </Test>
        <Case>
            <tags> Cluster DSCP Marking </tags>
            <wrapper> [[run_time:db_tests_path]]/sonic-mgmt/sonic-tool/mars/scripts/canonical_mars_pytest_runner.py </wrapper>
            <tout> 1920 </tout>
            <tags>ALL</tags>
        </Case>
    </global>

    <case>
        <name> Cluster DSCP Marking complete flow </name>
        <info></info>
        <tout> 1920 </tout>
        <cmd>
            <params>
                <static_args> --setup_name [[conf:extra_info.setup_name]] --test_script /root/mars/workspace/sonic-mgmt/ngts/tests_nvos/cluster/test_cluster_dscp_marking.py --raw_options "\'--rootdir=/root/mars/workspace/sonic-mgmt/ngts -c /root/mars/workspace/sonic-mgmt/ngts/pytest.ini -k test_dscp_marking_complete_flow --log-level=INFO --default_pass_env_var=[[conf:extra_info.default_pass_env_var]] --ansible_inventory_file=[[conf:extra_info.ansible_inventory_file:False]] --clean-alluredir --alluredir=/tmp/allure-results --showlocals  [[conf:extra_info.additional_options]]  --timeout 1800   \'"</static_args>
            </params>
        </cmd>
    </case>

    <case>
        <name> Cluster DSCP Marking invalid value </name>
        <info></info>
        <tout> 1920 </tout>
        <cmd>
            <params>
                <static_args> --setup_name [[conf:extra_info.setup_name]] --test_script /root/mars/workspace/sonic-mgmt/ngts/tests_nvos/cluster/test_cluster_dscp_marking.py --raw_options "\'--rootdir=/root/mars/workspace/sonic-mgmt/ngts -c /root/mars/workspace/sonic-mgmt/ngts/pytest.ini -k test_dscp_marking_invalid_value --log-level=INFO --default_pass_env_var=[[conf:extra_info.default_pass_env_var]] --ansible_inventory_file=[[conf:extra_info.ansible_inventory_file:False]] --clean-alluredir --alluredir=/tmp/allure-results --showlocals  [[conf:extra_info.additional_options]]  --timeout 300   \'"</static_args>
            </params>
        </cmd>
    </case>

</CASEDEF>
