<?xml version="1.0" encoding="UTF-8" ?>
<CASEDEF>
  <global>
    <Test>
      <group> NVOS </group>
      <name> NVOS - UDS network isolation (TC-DNI-01,02,03,05) </name>
      <info> Unix domain socket permissions, internal port non-exposure, published gNMI (9339), external nmap with ACL removed </info>
      <owner> Nadav Vilder </owner>
    </Test>
    <Case>
      <wrapper> [[run_time:db_tests_path]]/sonic-mgmt/sonic-tool/mars/scripts/canonical_mars_pytest_runner.py </wrapper>
      <tout> 10800 </tout>
      <tags>ALL</tags>
    </Case>
  </global>

  <case>
    <name> UDS network isolation </name>
    <info> test_uds_network_isolation.py </info>
    <cmd>
      <params>
          <static_args> --setup_name [[conf:extra_info.setup_name]]
          --test_script /root/mars/workspace/sonic-mgmt/ngts/tests_nvos/general/security/uds_network_isolation/test_uds_network_isolation.py
          --raw_options "\'--rootdir=/root/mars/workspace/sonic-mgmt/ngts -c /root/mars/workspace/sonic-mgmt/ngts/pytest.ini
          --release_name=[[conf:extra_info.release_name]] --log-level=INFO --default_pass_env_var=[[conf:extra_info.default_pass_env_var]]
          --clean-alluredir  --alluredir=/tmp/allure-results --showlocals  [[conf:extra_info.additional_options]]  --timeout 1500   \'"</static_args>
      </params>
    </cmd>
  </case>

</CASEDEF>
