<?xml version="1.0" encoding="UTF-8" ?>
<CASEDEF>
  <global>
    <Test>
      <group> NVOS </group>
      <name> NVOS NVL6 Zombie Link Tests </name>
      <info> Tests for NVL6 tx-bandwidth-loss-monitor (zombie link) feature </info>
      <owner> NVOS Team </owner>
    </Test>
    <Case>
      <wrapper> [[run_time:db_tests_path]]/sonic-mgmt/sonic-tool/mars/scripts/canonical_mars_pytest_runner.py </wrapper>
      <tout> 3600 </tout>
      <tags>ALL</tags>
    </Case>
  </global>

  <case>
    <name> nvl6 zombie link test </name>
    <info> Test tx-bandwidth-loss-monitor (zombie link) on NVL6 QTM4 devices </info>
    <tout> 1800 </tout>
    <cmd>
      <params>
          <static_args> --setup_name [[conf:extra_info.setup_name]] --test_script /root/mars/workspace/sonic-mgmt/ngts/tests_nvos/interfaces/nvl_port/nvl6/test_zombie_link.py --raw_options "\'--rootdir=/root/mars/workspace/sonic-mgmt/ngts -c /root/mars/workspace/sonic-mgmt/ngts/pytest.ini --release_name=[[conf:extra_info.release_name]] --log-level=INFO --default_pass_env_var=[[conf:extra_info.default_pass_env_var]] --clean-alluredir --alluredir=/tmp/allure-results --showlocals  [[conf:extra_info.additional_options]]  --timeout 900   \'"</static_args>
      </params>
    </cmd>
    <ignore>
      <condition>
        <key>dut_type</key>
        <op> not in </op>
        <value>[rosalind, rosalind-surrogate, rosalind-chipless]</value>
      </condition>
    </ignore>
  </case>

</CASEDEF>
