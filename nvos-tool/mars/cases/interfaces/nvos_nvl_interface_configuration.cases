<?xml version="1.0" encoding="UTF-8" ?>
<CASEDEF>
  <global>
    <Test>
      <group> NVOS </group>
      <name> NVL Interface Configuration Tests </name>
      <info> </info>
      <owner> Rami Hasan </owner>
    </Test>
    <Case>
      <tags> nvl interface configuration </tags>
      <wrapper> [[run_time:db_tests_path]]/sonic-mgmt/sonic-tool/mars/scripts/canonical_mars_pytest_runner.py </wrapper>
      <tout> 10800 </tout>
      <tags>ALL</tags>
      <ignore>
        <condition>
        <key>dut_type</key>
        <op> not in </op>
        <value>[juliet]</value>
        </condition>
      </ignore>
    </Case>
  </global>

  <case>
    <name> nvl5 fw recovery test </name>
    <info> </info>
    <tout> 10800 </tout>
    <cmd>
      <params>
          <static_args> --setup_name [[conf:extra_info.setup_name]] --test_script /root/mars/workspace/sonic-mgmt/ngts/tests_nvos/interfaces/nvl5_port/test_interface_fw_recovery.py --raw_options "\'--rootdir=/root/mars/workspace/sonic-mgmt/ngts -c /root/mars/workspace/sonic-mgmt/ngts/pytest.ini --release_name=[[conf:extra_info.release_name]] --log-level=INFO --default_pass_env_var=[[conf:extra_info.default_pass_env_var]] --clean-alluredir --alluredir=/tmp/allure-results --showlocals  [[conf:extra_info.additional_options]]  --timeout 900   \'"</static_args>
      </params>
    </cmd>
  </case>

</CASEDEF>
