            "{{port}}|1": {"scheduler": "large_packet_dwrr"}{% if not loop.last or unconnected_ports|length>0 %},{% endif %}
        {%- endfor %}
        {%- for port in unconnected_ports %}
            "{{port}}|4": {"scheduler": "small_packet_dwrr"},
