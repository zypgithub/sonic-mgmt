{
    "BUFFER_QUEUE": {
        {%- for port in connected_ports %}
            "{{port}}|4": {"profile": "q_lossy_profile"},
            "{{port}}|1": {"profile": "q_lossy_profile"}{% if not loop.last or unconnected_ports|length>0 %},{% endif %}
        {%- endfor %}
        {%- for port in unconnected_ports %}
            "{{port}}|4": {"profile": "q_lossy_profile"},
            "{{port}}|1": {"profile": "q_lossy_profile"}{% if not loop.last %},{% endif %}
        {%- endfor %}
    },
    "QUEUE": {
        {%- for port in connected_ports %}
