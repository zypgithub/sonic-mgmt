{
    "ACL_RULE": {
        "table1|DROP_ARP": {
            "ETHER_TYPE": "2054",
            "PACKET_ACTION": "DROP",
            "PRIORITY": "9986"
        },
        "table1|DROP_ICMP_IPV4": {
            "IP_PROTOCOL": "1",
            "PACKET_ACTION": "DROP",
            "PRIORITY": "9987"
        },
        "table2|DROP_ICMP_IPV6": {
            "ICMPV6_TYPE": "128",
            "PACKET_ACTION": "DROP",
            "PRIORITY": "9988"
        }
    },
    "ACL_TABLE": {
        "table1": {
            "policy_desc": "table of ingress ports",
            "ports": {{unconnected_ports | tojson}},
            "stage": "ingress",
            "type": "L3"
        },
        "table2": {
            "policy_desc": "table of ingress ports",
            "ports": {{unconnected_ports | tojson}},
            "stage": "ingress",
            "type": "L3V6"
        }
    },
    "VLAN": {
        {% for vlan in vlan_conf %}
        "Vlan{{ vlan }}": {
            "vlanid": "{{ vlan }}"
        }{% if not loop.last %},{% endif %}
        {% endfor %}
    },

    {% if dut_alias == "left_tg" %}
    {% set vlan_ip_prefix = "dddd" %}
    {% else %}
    {% set vlan_ip_prefix = "eeee" %}
    {% endif %}

    "VLAN_INTERFACE": {
        {% for vlan in vlan_conf %}
        "Vlan{{ vlan}}": {},
        "Vlan{{ vlan}}|fcbb:{{vlan_ip_prefix}}:{{loop.index}}::/48": {}{% if not loop.last %},{% endif %}
        {% endfor %}
    },

    "VLAN_MEMBER": {
        {% for vlan, mloop in vlan_conf.items() %}
        "Vlan{{ vlan }}|{{ mloop[0] }}": {
            "tagging_mode": "untagged"
        },
        "Vlan{{ vlan }}|{{ mloop[1] }}": {
            "tagging_mode": "untagged"
        }{% if not loop.last %},{% endif %}
        {% endfor %}
    },
    "BUFFER_POOL": {
        "ingress_lossless_pool": {"type": "ingress", "mode": "dynamic"},
        "egress_lossy_pool":    {"type": "egress",  "mode": "dynamic"},
        "egress_lossless_pool":    {"type": "egress",  "mode": "dynamic"}
    },
    "BUFFER_PROFILE": {
        "front_small_size_queue_profile": {"dynamic_th": "2", "pool": "egress_lossy_pool", "size": "1500"},
        "front_large_size_queue_profile": {"dynamic_th": "3", "pool": "egress_lossy_pool", "size": "90000"},
        "lpbk_small_size_queue_profile":  {"dynamic_th": "2", "pool": "egress_lossy_pool", "size": "1500"},
        "lpbk_large_size_queue_profile":  {"dynamic_th": "3", "pool": "egress_lossy_pool", "size": "310000"},
        "egress_lossy_profile":           {"dynamic_th": "3", "pool": "egress_lossy_pool", "size": "0"},
        "ingress_lossless_profile":       {"dynamic_th": "3", "pool": "ingress_lossless_pool", "size": "0"}
    },
    "SCHEDULER": {
        "small_packet_dwrr": {"type": "DWRR", "weight": "1"},
        "large_packet_dwrr": {"type": "DWRR", "weight": "64"}
    }
}
