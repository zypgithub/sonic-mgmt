{
  "manifest_version": 3,
  "name": "AllurClick2Rm",
  "version": "1.0",
  "description": "Create RM issue from Allure test report",
  "content_scripts": [
    {
      "matches": [
        "https://allure.nvidia.com/*/reports/*/index.html*"
      ],
      "js": [
        "UsernameManager.js",
        "RichTextEditor.js",
        "BugDraftStorage.js",
        "BugReportUI.js",
        "BugDataCollector.js",
        "Sender.js",
        "content.js"
      ]
    }
  ],
  "permissions": [
    "activeTab"
  ]
}
